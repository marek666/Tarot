{
  "name": "tarot-trainer",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "download:cards": "node scripts/download-card-images.mjs",
    "validate:data": "node scripts/validate-deck.ts",
    "validate:pwa": "node scripts/validate-pwa.ts",
    "verify:production": "node scripts/verify-production.ts",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run validate:data && svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "verify": "npm test && npm run check && npm run build && npm run validate:pwa && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
